# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API / API Keys).
# Use SOMENTE a chave publicável (sb_publishable_...) ou a "anon".
# NUNCA coloque aqui a chave secreta / service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
